# Environment variables this project needs. Copy into .env.
#
# Connection ids used in code:
#   warehouse_default   read-write, all schemas. Ingestion Dags, dbt via Cosmos, context Dags, plugin.
#   warehouse_readonly  read-only, gold only, as the analytics_reader role. The agent's SQL toolset.
#   airflow_api_default Airflow's REST API. capture_pipeline_metadata.
#   pydanticai_default  LLM connection for @task.agent and @task.llm.

OPENAI_API_KEY=


AIRFLOW_CONN_WAREHOUSE_DEFAULT='{
    "conn_type": "postgres",
    "host": "warehouse",
    "port": 5432,
    "login": "warehouse",
    "password": "warehouse",
    "schema": "warehouse"
}'

AIRFLOW_CONN_WAREHOUSE_READONLY='{
    "conn_type": "postgres",
    "host": "warehouse",
    "port": 5432,
    "login": "analytics_reader",
    "password": "analytics_reader",
    "schema": "warehouse"
}'

AIRFLOW_CONN_AIRFLOW_API_DEFAULT='{
    "conn_type": "http",
    "host": "api-server",
    "port": 8080,
    "schema": "http"
}'

AIRFLOW_CONN_PYDANTICAI_DEFAULT='{
    "conn_type": "pydanticai",
    "extra": {"model": "openai:gpt-5-mini"}
}'


AIRFLOW__TRACES__OTEL_ON=True
AIRFLOW__TRACES__OTEL_HOST=otel-collector
AIRFLOW__TRACES__OTEL_PORT=4317
AIRFLOW__COMMON_AI__OTEL_EXPORT_ENABLED=True
AIRFLOW__COMMON_AI__CAPTURE_CONTENT=True

DBT_SEND_ANONYMOUS_USAGE_STATS=False
